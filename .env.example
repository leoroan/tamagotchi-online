# Copiar a .env.local (NUNCA commitear el .env.local).
# Fase 4: Supabase. Sin esto la app funciona 100% local (localStorage).
# OJO: Supabase deprecó la vieja "anon key". Usá la publishable key
# (Dashboard → Project Settings → API Keys → "Publishable key", empieza con sb_publishable_).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para el build de GitHub Pages (lo setea el workflow).
# VITE_BASE=/tamagotchi-online/
